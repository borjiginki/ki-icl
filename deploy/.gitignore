# Provider binaries and plugin cache.
.terraform/
.terraform.lock.hcl

# State holds resource ids and whatever a future resource decides to record. It lives
# in a remote azurerm backend now (see versions.tf and backend.hcl), not locally, but
# terraform init still leaves a thin local pointer file behind.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real values, including a subscription id somebody may not want in git.
terraform.tfvars
*.auto.tfvars

# The one committed exception: stable baseline vars true for every apply, human or CI,
# with nothing secret in it. See ci.auto.tfvars itself for why each value is there.
!ci.auto.tfvars

# Saved plans can contain variable values.
*.tfplan
