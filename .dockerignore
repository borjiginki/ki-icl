# .git used to be deliberately kept for the packager's version-stamping git log calls.
# Packaging now happens at publish time (see deploy/README.md), not in this image, so
# this build no longer needs history at all.
.git/
.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
logs/
deploy/.terraform/
deploy/*.tfstate
deploy/*.tfstate.*
deploy/terraform.tfvars
